{
  "name": "nextjs-16-project-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "local": "next dev -p 17900",
    "dev": "next dev -p 17900",
    "build": "prisma generate && prisma migrate deploy && next build && node scripts/prepare-standalone.mjs",
    "build:remote": "dotenv -e .env.development -- pnpm build",
    "start": "PORT=17900 node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local .next/standalone/server.js",
    "start:remote": "PORT=17900 dotenv -e .env.development -- node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:server:build": "dotenv -e .env.test -- prisma migrate deploy && NODE_ENV=production dotenv -e .env.test -- next build && rm -rf .next/standalone/public .next/standalone/.next/static && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static && (for d in node_modules/.pnpm/@img+sharp-libvips*; do cp -Rf \"$d/.\" \".next/standalone/$d/\" 2>/dev/null; done; true)",
    "test:server": "NODE_ENV=production dotenv -e .env.test -- node .next/standalone/server.js",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio -p 17930",
    "db:migrate:remote": "dotenv -e .env.development -- prisma migrate deploy",
    "db:studio:remote": "dotenv -e .env.development -- prisma studio -p 17930",
    "withwiz:update": "pnpm update @withwiz/toolkit @withwiz/ui @withwiz/auth-ui",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@withwiz/auth-ui": "latest",
    "@withwiz/toolkit": "latest",
    "@withwiz/ui": "latest",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "nodemailer": "^7.0.9",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
