{
  "name": "nextjs-16-project-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "local": "next dev -p 17900",
    "dev": "next dev -p 17900",
    "dev:remote": "dotenv -e .env.dev -- next dev -p 17900",
    "build": "prisma generate && prisma migrate deploy && next build",
    "build:remote": "dotenv -e .env.dev -- pnpm build",
    "start": "next start -p 17900",
    "start:remote": "dotenv -e .env.dev -- next start -p 17900",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:server": "dotenv -e .env.test -- next dev -p 17905",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio -p 17930",
    "db:migrate:remote": "dotenv -e .env.dev -- prisma migrate deploy",
    "db:studio:remote": "dotenv -e .env.dev -- prisma studio -p 17930",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@withwiz/auth-ui": "^0.6.1",
    "@withwiz/toolkit": "^0.13.0",
    "@withwiz/ui": "^0.3.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "jose": "^6.2.3",
    "next": "16.2.9",
    "nodemailer": "^7.0.9",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
