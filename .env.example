# ─────────────────────────────────────────────────────────────
# nextjs-project-wizard 환경변수 템플릿 — 복사해서 채울 것:  cp .env.example .env.local
# 프로필 분리 (전부 gitignore):
#   .env.local       로컬 개발. `pnpm dev` / bare prisma 명령이 자동 로드
#   .env.dev         공용 dev 서버. `pnpm dev:remote` 등 *:remote 스크립트
#   .env.production  프로덕션 배포
#   .env.test        테스트(E2E 포트 17905, DB 17906)
# ─────────────────────────────────────────────────────────────

NODE_ENV="development"

# DB (로컬 docker: docker compose up -d → 호스트 포트 17901)
DATABASE_URL="postgresql://postgres:postgres@localhost:17901/nextjs_project_wizard"

# 앱 URL / 포트
PORT="17900"
APP_BASE_URL="http://localhost:17900"
NEXT_PUBLIC_APP_URL="http://localhost:17900"

# 인증 (withwiz/toolkit). 32자 이상 랜덤 문자열 필수
JWT_SECRET="change-me-to-a-random-string-min-32-chars-000"

# 시드 부트스트랩 Owner 계정 (prisma db seed). 미설정 시 admin@example.local / changeme-dev-only
OWNER_EMAIL=""
OWNER_PASSWORD=""

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE="ko"

# 이메일 (nodemailer SMTP — 비밀번호 재설정/인증 메일). 미설정 시 콘솔에 로깅만
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="nextjs-16-project-template <no-reply@example.local>"

# Rate Limit (withwiz/toolkit 미들웨어). 로컬은 false 권장
RATE_LIMIT_ENABLED="false"

# OAuth (선택). id+secret 둘 다 채워야 해당 provider 버튼 활성화. 비우면 무시
# Google redirect URI: {APP_BASE_URL}/api/auth/oauth/callback/google
# GitHub redirect URI: {APP_BASE_URL}/api/auth/oauth/callback/github
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
